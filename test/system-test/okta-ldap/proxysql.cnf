datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

# Load Okta LDAP authentication plugin
ldap_auth_plugin="/usr/lib/proxysql/proxysql_okta_ldap_auth.so"

admin_variables=
{
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"
    pgsql_ifaces="0.0.0.0:6132"
}

mysql_variables=
{
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
    have_compress=true
    poll_timeout=2000
    interfaces="0.0.0.0:6033"
    default_schema="information_schema"
    stacksize=1048576
    server_version="8.0.36"
    connect_timeout_server=3000
    monitor_username="monitor"
    monitor_password="monitor_pass"
    monitor_history=600000
    monitor_connect_interval=60000
    monitor_ping_interval=10000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=500
    ping_interval_server_msec=120000
    ping_timeout_server=500
    commands_stats=true
    sessions_sort=true
    connect_retries_on_failure=10
}

pgsql_variables=
{
    interfaces="0.0.0.0:6133"
    monitor_username="monitor"
    monitor_password="monitor_pass"
}

# Backend MySQL servers: instance1 (hostgroup 0), instance2 (hostgroup 1)
mysql_servers=
(
    {
        address="mysql"
        port=3306
        hostgroup=0
        max_connections=200
    },
    {
        address="mysql2"
        port=3306
        hostgroup=1
        max_connections=200
    }
)

# Backend PostgreSQL server
pgsql_servers=
(
    {
        address="pgsql"
        port=5432
        hostgroup=0
        max_connections=200
    }
)

# MySQL users: standard frontend user + backend-only user for LDAP-mapped connections
mysql_users=
(
    {
        username="testuser"
        password="testpass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=1
        max_connections=200
    },
    {
        username="okta_shared"
        password="okta_backend_pass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=0
        max_connections=1000
    },
    {
        username="monitor"
        password="monitor_pass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=0
        max_connections=10
    }
)

# PostgreSQL users: standard frontend user + backend-only user for LDAP-mapped connections
pgsql_users=
(
    {
        username="testuser"
        password="testpass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=1
        max_connections=200
    },
    {
        username="okta_pgsql"
        password="okta_pgsql_pass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=0
        max_connections=1000
    },
    {
        username="limiteduser"
        password="limitedpass"
        default_hostgroup=0
        active=1
        backend=1
        frontend=1
        max_connections=200
    }
)
